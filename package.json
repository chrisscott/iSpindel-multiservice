{
  "name": "ispindel-multiservice",
  "version": "1.0.4",
  "description": "Send iSpindel data to multiple services",
  "keywords": [
    "homebrewing",
    "ispindel"
  ],
  "license": "MIT",
  "author": "Chris Scott",
  "main": "build/index.js",
  "scripts": {
    "build": "pnpm tsc -p tsconfig.json",
    "prebuild": "rimraf build",
    "start": "pnpm build && node build/src/index.js",
    "dev": "nodemon",
    "test": "pnpm build && tap run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "dotenv release-it --"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "envsub": "^4.1.0",
    "fastify": "^5.11.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/sinon": "^21.0.1",
    "debug": "^4.4.3",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.14",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "release-it": "^20.2.1",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "tap": "^21.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "nodemonConfig": {
    "exec": "pnpm build && pnpm start",
    "ext": "ts",
    "watch": [
      "."
    ]
  },
  "tap": {
    "include": [
      "build/tests/**/*.test.js"
    ]
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6"
}
