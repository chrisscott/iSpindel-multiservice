{
  "name": "ispindel-multiservice",
  "version": "1.0.4",
  "description": "Send iSpindel data to multiple services",
  "main": "build/index.js",
  "scripts": {
    "build": "pnpm tsc -p tsconfig.json",
    "prebuild": "rimraf build",
    "start": "pnpm build && node build/src/index.js",
    "dev": "nodemon",
    "test": "pnpm build && tap run",
    "release": "dotenv release-it --"
  },
  "keywords": [
    "ispindel",
    "homebrewing"
  ],
  "author": "Chris Scott",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.0",
    "envsub": "^4.1.0",
    "fastify": "^5.8.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/sinon": "^21.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "debug": "^4.4.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.2.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.32.0",
    "nodemon": "^3.1.14",
    "release-it": "^19.2.4",
    "rimraf": "^6.1.3",
    "sinon": "^21.0.3",
    "tap": "^21.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "exec": "pnpm build && pnpm start",
    "ext": "ts"
  },
  "tap": {
    "include": [
      "build/tests/**/*.test.js"
    ]
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6"
}
